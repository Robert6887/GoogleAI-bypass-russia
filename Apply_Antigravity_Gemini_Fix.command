#!/bin/bash
DIR="$(cd "$(dirname "$0")" && pwd)"
clear
echo "======================================================================"
echo "  ⚡ ANTIGRAVITY + VOICE INPUT + GEMINI DESKTOP BYPASS (macOS) ⚡"
echo "  Сейчас macOS попросит ввести пароль администратора (sudo)"
echo "======================================================================"
echo ""
sudo /usr/bin/python3 "$DIR/macos-instant-fix.py"
echo ""
echo "======================================================================"
echo "  Готово! Перезапустите Gemini.app и Antigravity."
echo "======================================================================"
read -n 1 -s -r -p "Нажмите любую клавишу для выхода..."
echo ""
